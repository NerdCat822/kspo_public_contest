# 저장소 루트에 .env 로 복사한 뒤 키를 채운다. .env 는 커밋하지 않는다.
# backend(Go)와 ai(Python) 모두 이 파일을 읽는다.

# KOPIS 공연예술통합전산망 (kopis.or.kr) - 공연 일정, 공연장 좌석
KOPIS_API_KEY=

# 서울 열린데이터광장 (data.seoul.go.kr) 일반 인증키 - 실시간 도시데이터, 돌발정보
SEOUL_API_KEY=

# 공공데이터포털 (data.go.kr) - 기상청 단기예보, 한국천문연구원 특일정보
DATA_GO_KR_KEY=

# 문화공공데이터광장 (culture.go.kr) - 한국체육산업개발 API (재학습 때 사용 예정). 서비스키가 API 마다 따로 발급된다
# 개발 계정은 키마다 하루 1,000건이고, 연달아 부르면 429 가 온다(약 1분에 한 번). numOfRows 는 최대 10,000
# 연계 데이터는 JSON 으로 받으면 DESCRIPTION(주차대수·기온 등)이 비어 오므로 XML(기본 형식)로 받는다
# 순서대로 연계 데이터(API_CPM_009), 입출차정보 전체구역(API_CPM_008), 공연정보(KSCperf), 대관정보(getKSCD0803)
CULTURE_API_KEY_LINKED=
CULTURE_API_KEY_INOUT=
CULTURE_API_KEY_PERF=
CULTURE_API_KEY_RENTAL=

# 한국체육산업개발 실시간 주차현황. 기관이 공개한 키라 비워 두면 기본값을 쓴다
KSPO_PARKING_KEY=

# 네이버 클라우드 플랫폼 Maps Application
# Client ID 는 화면 지도 스크립트에 쓰는 공개 값(콘솔 Web 서비스 URL 에 http://localhost 와 배포 도메인 등록 필요)
# Client Secret 은 서버에서 부르는 REST API 용 비밀 값
NAVER_CLOUD_PLATFORM_CLIENT_ID=
NAVER_CLOUD_PLATFORM_CLIENT_SECRET=

# 상담 에이전트(ai/) - Claude API 키. 비워 두면 상담 기능만 꺼진다
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5-5
# LLM_EFFORT=medium

# PostgreSQL. 주면 실시간 수집 기록과 공공 API 캐시를 스키마 gilmak 에 남기고, 비워 두면 backend/data/ 파일에 남긴다
# docker-compose.yml 은 컨테이너 안에서 DATABASE_HOST=postgres-db 로 호스트만 바꾼다
# DATABASE_URL=postgres://gilmak_doctor:<비밀번호>@127.0.0.1:5432/gilmak_doctor?sslmode=disable

# 서비스 주소(기본값을 쓰면 비워 둔다)
# AI_SERVICE_URL=http://127.0.0.1:8090    # Go 가 부르는 Python AI 서비스
# GILMAK_API_URL=http://127.0.0.1:8080    # Python 에이전트가 부르는 Go API
